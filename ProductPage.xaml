<Page x:Class="Yakupova_41razmer.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yakupova_41razmer"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily=" Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        
        
        <WrapPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Вы авторизованы как " FontSize="25"/>
                <TextBlock Name="FIOTB" FontSize="25"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Роль: " FontSize="25"/>
                <TextBlock Name="RoleTB" FontSize="25"/>
            </StackPanel>
        </WrapPanel>

        
        
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Кол-во " FontSize="25"/>
                <TextBlock Name="FirstCifri" FontSize="25"/>
                <TextBlock Text=" из " FontSize="25"/>
                <TextBlock Name="SecondCifri" FontSize="25" />
            </StackPanel>

            <StackPanel Margin="10" Orientation="Vertical">
                <TextBlock Text="Введите название для поиска " TextAlignment="Center"
                   Width="300" FontSize="20"></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged"    
                   Width="300" FontSize="15"></TextBox>
            </StackPanel>

            <StackPanel Grid.Row="1"  Orientation="Vertical"  Margin="5">
                <RadioButton Content="По возрастанию стоимости" GroupName="Sort"
             Width="300" FontSize="20" Name="RButtonUp" Checked="RButtonUp_Checked"></RadioButton>
                <RadioButton Content="По убыванию стоимости" GroupName="Sort"
             Width="300" FontSize="20" Name="RButtonDown" Checked="RButtonDown_Checked"></RadioButton>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text=" Фильтрация по скидке " TextAlignment="Center"
                   Width="300" FontSize="20"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged"
                  FontSize="15" Width="200">
                    <TextBlock>Все</TextBlock>
                    <TextBlock> от 0% до 9,99%</TextBlock>
                    <TextBlock> от 10% до 14,99%</TextBlock>
                    <TextBlock> от 15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>


        
        <ListView Name="ProductListView" Grid.Row="3">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="1000"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        
                        <Image Width="200" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="PathProductPhoto">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>



                        <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontWeight="Bold" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding ProductDescription}" Grid.Row="1" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Manufacture.NameManufacture}" Grid.Row="2" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding ProductCost, StringFormat = {}{0:0} рублей}" Grid.Row="3" HorizontalAlignment="Left" FontSize="20"></TextBlock>

                        <TextBlock Grid.Column="2" Text="Скидка" Grid.Row="0" HorizontalAlignment="Right" FontSize="20"></TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding ProductDiscountAmount, StringFormat= {}{0:0} %}" Grid.Row="1" HorizontalAlignment="Right" FontSize="50"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
       
    </Grid>
</Page>
